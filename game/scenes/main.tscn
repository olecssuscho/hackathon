[sub_resource type="Resource" id="Resource_jyhfs"]
script = ExtResource("5_tbgi4")
poi_name = "Корпусний сад"
latitude = 49.59
longitude = 34.551
description = "Корпусний сад — парк круглої форми на Круглій площі, має вісім радіальних алей. Тут налічується близько 70 видів дерев і кущів, розбито клумби півоній і троянд, інших квітів. Чимало рідкісних видів дерев."
image_url = "https://thumb.wikimedia.org/wikipedia/commons/thumb/7/78/%D0%A3%D0%BA%D1%80%D0%B0%D0%B8%D0%BD%D0%B0%2C_%D0%9F%D0%BE%D0%BB%D1%82%D0%B0%D0%B2%D0%B0_-_%D0%9A%D0%BE%D1%80%D0%BF%D1%83%D1%81%D0%BD%D1%8B%D0%B9_%D1%81%D0%B0%D0%B4_06.jpg/250px-%D0%A3%D0%BA%D1%80%D0%B0%D0%B8%D0%BD%D0%B0%2C_%D0%9F%D0%BE%D0%BB%D1%82%D0%B0%D0%B2%D0%B0_-_%D0%9A%D0%BE%D1%80%D0%BF%D1%83%D1%81%D0%BD%D1%8B%D0%B9_%D1%81%D0%B0%D0%B4_06.jpg?utm_source=uk.wikipedia.org&utm_campaign=parser&utm_content=thumbnail"
